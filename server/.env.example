# Shared access key every plugin user must enter (change this!)
ACCESS_KEY=change-me-to-a-long-random-string
# Port the server listens on (users enter <server-ip> for 443, or <server-ip>:<port> otherwise)
PORT=443
MAX_FILE_MB=200
FILE_TTL_HOURS=72
PTT_MAX_SECONDS=90
# Only for docker-compose.domain.yml (domain name + automatic public certificate):
#DOMAIN=comms.example.com
